<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- canOpenURL("comgooglemaps://") returns FALSE unless the scheme is
	     declared here, whatever is installed on the phone. Without this entry
	     the app would fall back to Apple Maps forever and nothing would say
	     why. Everything else in the Info.plist is still generated by Xcode
	     from the INFOPLIST_KEY_* build settings and merged into this file. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>

	<!-- Continuous location while the app is not in front. Needed for exactly
	     one thing: the map a stranded customer is watching must keep moving
	     while the driver is in Maps, on a call, or with the screen off, which
	     is where a driver spends the whole journey. Without this the marker
	     freezes the instant he switches app and the customer concludes nobody
	     is coming.

	     Scoped in code to a live job: see JobTracker, which starts on accept
	     and stops the moment the server says the job is over. Like
	     LSApplicationQueriesSchemes above, this is an array and so has no
	     INFOPLIST_KEY_ equivalent to set from the build settings. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
