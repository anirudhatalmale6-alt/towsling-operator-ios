<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- canOpenURL("comgooglemaps://") returns FALSE unless the scheme is
	     declared here, whatever is installed on the phone. Without this entry
	     the app would fall back to Apple Maps forever and nothing would say
	     why. Everything else in the Info.plist is still generated by Xcode
	     from the INFOPLIST_KEY_* build settings and merged into this file. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
</dict>
</plist>
