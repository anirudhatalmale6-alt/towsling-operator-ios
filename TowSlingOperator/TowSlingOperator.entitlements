<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this, registerForRemoteNotifications fails with "no valid
	     aps-environment entitlement string found" and no token ever arrives.
	     "development" is correct for builds signed with a development profile;
	     Xcode substitutes "production" when exporting for TestFlight or the
	     App Store, and the app reports which one it ended up with so the server
	     sends to the matching Apple host. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
